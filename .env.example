# Next base url
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Mobile app
NEXT_MOBILE_BASE_URL=http://192.168.x.x:8081

# Authentication (Google)
# Generate AUTH_SECRET with: npx auth secret   (or: openssl rand -hex 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=

# Database connection
MONGODB_URI=mongodb://localhost:27017/your-database-name

# Email verify (SMTP)
# For Gmail, use an App Password, not your normal password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=
EMAIL_FROM_NAME="Your Shop Name"
EMAIL_FROM_EMAIL=your-email@gmail.com
EMAIL_OTP_EXPIRES_MINUTES=10

# Cloudinary image upload
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ABA PayWay (sandbox)
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
PAYWAY_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Expiry date of PAYWAY_API_KEY (YYYY-MM-DD)
PAYWAY_API_KEY_EXPIRES_AT=

